{
  "name": "@tuello/worker",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/lib-storage": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@sentry/node": "^10.75.3",
    "@tuello/db": "workspace:*",
    "@tuello/shared": "workspace:*",
    "bullmq": "^5.81.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.13",
    "pino": "^9.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.18.0",
    "pino-pretty": "^13.1.1",
    "testcontainers": "^11.14.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
