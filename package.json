{
  "name": "tuello",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @tuello/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @tuello/db migrate:deploy",
    "db:seed": "pnpm --filter @tuello/db seed",
    "db:generate": "pnpm --filter @tuello/db generate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
