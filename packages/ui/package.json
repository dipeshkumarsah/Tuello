{
  "name": "@tuello/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Tuello black-and-white design system. Consumed as TypeScript source by apps/web.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/tokens.css"
  },
