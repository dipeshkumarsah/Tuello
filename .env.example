# Copy to .env (never commit .env). Values here match docker-compose.yml for local development.
# Every secret in production comes from the environment (Coolify), never from the repository.

# --- Database -------------------------------------------------------------------------------
# Runtime role: RLS-restricted, through PgBouncer in transaction mode.
DATABASE_URL=postgresql://tuello_app:tuello_app@localhost:6432/tuello?pgbouncer=true
# Migrations and seeds that need the owner role connect directly (not through PgBouncer).
DIRECT_DATABASE_URL=postgresql://tuello:tuello@localhost:5432/tuello
SLOW_QUERY_MS=200

# --- Valkey (queues, cache, sessions) ----------------------------------------------------
VALKEY_URL=redis://localhost:6379

# --- Hosts --------------------------------------------------------------------------------
# Tenants live at {slug}.APP_BASE_DOMAIN. *.localhost resolves to 127.0.0.1 in browsers.
APP_BASE_DOMAIN=tuello.localhost
APP_PUBLIC_PROTOCOL=http
APP_PUBLIC_PORT=3000
CUSTOM_DOMAIN_TARGET=domains.tuello.localhost
TRUST_PROXY=true
API_INTERNAL_URL=http://localhost:4000
PORT=4000

# --- Security -----------------------------------------------------------------------------
# false only for local http. Production: true.
COOKIE_SECURE=false
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts TOTP secrets at rest.
ENCRYPTION_KEY=
RATE_LIMIT_FACTOR=1
# Cloudflare Turnstile (free). Leave empty to disable bot checks locally.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Object storage (S3 API: MinIO locally, Cloudflare R2 in production) -----------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tuello
S3_ACCESS_KEY_ID=tuello
S3_SECRET_ACCESS_KEY=tuello-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Email (any SMTP; Mailpit locally at http://localhost:8025) ---------------------------
SMTP_URL=smtp://localhost:1025
EMAIL_FROM_ADDRESS=no-reply@mail.tuello.localhost

# --- Custom domains -----------------------------------------------------------------------
TLS_PROVISIONER=caddy-on-demand
DNS_SERVERS=

# --- Observability (all optional) ---------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
RELEASE=dev
